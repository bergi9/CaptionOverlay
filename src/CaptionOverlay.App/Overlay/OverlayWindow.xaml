<Window x:Class="CaptionOverlay.App.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CaptionOverlay.App.Overlay"
        Title="CaptionOverlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        Width="800" Height="120"
        UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#CC303440" />
            <Setter Property="BorderBrush" Value="#66FFFFFF" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" />
        </Storyboard>
    </Window.Resources>

    <Grid x:Name="Root" VerticalAlignment="Bottom">
        <DockPanel LastChildFill="True">
            <!-- Edit-mode toolbar -->
            <Border DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="0,0,0,6" Padding="6,4"
                    CornerRadius="6" Background="#E0202430"
                    Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Font" Foreground="White" VerticalAlignment="Center" Margin="4,0" />
                    <Button Style="{StaticResource ToolButton}" Content="−" Command="{Binding DecreaseFontCommand}" ToolTip="Smaller text" />
                    <Button Style="{StaticResource ToolButton}" Content="+" Command="{Binding IncreaseFontCommand}" ToolTip="Larger text" />
                    <TextBlock Text="Lines" Foreground="White" VerticalAlignment="Center" Margin="10,0,4,0" />
                    <Button Style="{StaticResource ToolButton}" Content="−" Command="{Binding FewerLinesCommand}" ToolTip="Fewer lines" />
                    <TextBlock Text="{Binding LinesShown}" Foreground="White" VerticalAlignment="Center" Margin="4,0" />
                    <Button Style="{StaticResource ToolButton}" Content="+" Command="{Binding MoreLinesCommand}" ToolTip="More lines" />
                    <TextBlock Text="Background" Foreground="White" VerticalAlignment="Center" Margin="10,0,4,0" />
                    <Slider x:Name="OpacitySlider" Width="90" Minimum="0" Maximum="1" VerticalAlignment="Center" Focusable="False"
                            Value="{Binding BackgroundOpacity}" PreviewMouseUp="OpacitySlider_OnMouseUp" />
                    <Button Style="{StaticResource ToolButton}" Content="Done" Margin="10,0,2,0" Command="{Binding DoneCommand}" FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <!-- Caption panel -->
            <Border x:Name="Panel" CornerRadius="10" Padding="18,8" Background="{Binding BackgroundBrush}"
                    BorderThickness="2">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="Opacity" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                <Setter Property="BorderBrush" Value="#FFFFC400" />
                                <Setter Property="Cursor" Value="SizeAll" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ShowPanel}" Value="False">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.6" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Lines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <local:OutlinedTextBlock Text="{Binding Text}"
                                                         FontFamily="{Binding DataContext.FontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         FontSize="{Binding DataContext.FontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         FontWeight="{Binding DataContext.FontWeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         Fill="{Binding DataContext.TextBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         Stroke="{Binding DataContext.OutlineBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         StrokeThickness="{Binding DataContext.OutlineThickness, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <local:OutlinedTextBlock.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard Storyboard="{StaticResource FadeIn}" />
                                        </EventTrigger>
                                    </local:OutlinedTextBlock.Triggers>
                                </local:OutlinedTextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Tentative (in-progress) line: dimmed and italic -->
                    <local:OutlinedTextBlock Text="{Binding TentativeText}" FontStyle="Italic" Opacity="0.72"
                                             FontFamily="{Binding FontFamily}" FontSize="{Binding FontSize}" FontWeight="{Binding FontWeight}"
                                             Fill="{Binding TextBrush}" Stroke="{Binding OutlineBrush}" StrokeThickness="{Binding OutlineThickness}">
                        <local:OutlinedTextBlock.Style>
                            <Style TargetType="local:OutlinedTextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TentativeText}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </local:OutlinedTextBlock.Style>
                    </local:OutlinedTextBlock>

                    <!-- Edit-mode placeholder -->
                    <StackPanel Visibility="{Binding ShowPlaceholder, Converter={StaticResource BoolToVis}}">
                        <local:OutlinedTextBlock Text="Captions appear here — drag to move, drag the edges to resize"
                                                 FontFamily="{Binding FontFamily}" FontSize="{Binding FontSize}" FontWeight="{Binding FontWeight}"
                                                 Fill="{Binding TextBrush}" Stroke="{Binding OutlineBrush}" StrokeThickness="{Binding OutlineThickness}" />
                    </StackPanel>
                    <TextBlock Text="{Binding StatusText}" Foreground="#FFFFC400" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"
                               Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>
        </DockPanel>

        <!-- Resize grips (edit mode) -->
        <Thumb x:Name="LeftGrip" HorizontalAlignment="Left" Width="10" Cursor="SizeWE" Opacity="0.01"
               DragDelta="LeftGrip_OnDragDelta" DragCompleted="Grip_OnDragCompleted"
               Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}" />
        <Thumb x:Name="RightGrip" HorizontalAlignment="Right" Width="10" Cursor="SizeWE" Opacity="0.01"
               DragDelta="RightGrip_OnDragDelta" DragCompleted="Grip_OnDragCompleted"
               Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}" />
    </Grid>
</Window>
