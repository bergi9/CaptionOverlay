<Window x:Class="CaptionOverlay.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:CaptionOverlay.App.Localization"
        xmlns:models="clr-namespace:CaptionOverlay.App.Models"
        Title="{l:Loc Settings_Title}"
        Width="840" Height="720" MinWidth="660" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{DynamicResource ApplicationBackgroundBrush}">
    <DockPanel>
        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Padding="12,6" Background="{DynamicResource LayerFillColorDefaultBrush}">
            <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
        </Border>

        <TabControl x:Name="Tabs" Margin="8" Padding="12">
            <!-- ───────────── General ───────────── -->
            <TabItem Header="{l:Loc Tab_General}" x:Name="GeneralTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Loc General_Appearance}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,3" Text="{l:Loc General_UiLanguage}" />
                                <ComboBox ItemsSource="{Binding UiLanguageChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding GeneralUiLanguage}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,3" Text="{l:Loc General_Theme}" />
                                <ComboBox ItemsSource="{Binding ThemeChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding GeneralTheme}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Loc General_Startup}" />
                        <CheckBox Content="{l:Loc General_StartWithWindows}" IsChecked="{Binding GeneralStartWithWindows}" />
                        <Border Style="{StaticResource WarningBox}" Visibility="{Binding StartupEntryWarning, Converter={StaticResource NullToCollapsed}}">
                            <StackPanel>
                                <TextBlock Text="{Binding StartupEntryWarning}" TextWrapping="Wrap" />
                                <Button Content="{l:Loc General_FixStartupEntry}" Command="{Binding FixStartupEntryCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <CheckBox Content="{l:Loc General_StartListening}" IsChecked="{Binding GeneralStartListeningOnLaunch}" />
                        <CheckBox Content="{l:Loc General_CheckForUpdates}" IsChecked="{Binding GeneralCheckForUpdates}" />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Loc General_Transcripts}" />
                        <CheckBox Content="{l:Loc General_AutoSave}" IsChecked="{Binding TranscriptsAutoSave}" />
                        <StackPanel Orientation="Horizontal" Margin="28,0,0,0" IsEnabled="{Binding TranscriptsAutoSave}">
                            <CheckBox Content="{l:Loc General_Srt}" IsChecked="{Binding TranscriptsSrt}" Margin="0,0,16,0" />
                            <CheckBox Content="{l:Loc General_Txt}" IsChecked="{Binding TranscriptsTxt}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Loc General_Folder}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{l:Loc Common_Open}" Command="{Binding OpenTranscriptsFolderCommand}" Margin="6,0,0,0" />
                            <TextBox Text="{Binding TranscriptsFolder, UpdateSourceTrigger=LostFocus}" />
                        </DockPanel>
                        <StackPanel IsEnabled="{Binding TranscriptsAutoSave}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Loc General_Split}" />
                            <ComboBox ItemsSource="{Binding TranscriptSplitChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding TranscriptsSplit}" />
                            <StackPanel Visibility="{Binding IsSplitAfterBreak, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Loc General_SplitAfterMinutes, Value={Binding TranscriptsSplitAfterMinutes}}" />
                                <Slider Minimum="5" Maximum="240" Value="{Binding TranscriptsSplitAfterMinutes}" IsSnapToTickEnabled="True" TickFrequency="5" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Text="{l:Loc General_SplitHint}" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Loc Common_Diagnostics}" />
                        <CheckBox Content="{l:Loc General_LogText}" IsChecked="{Binding GeneralLogTranscriptText}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ───────────── Audio ───────────── -->
            <TabItem Header="{l:Loc Tab_Audio}" x:Name="AudioTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Loc Audio_Output}" />
                        <TextBlock Style="{StaticResource Hint}" Text="{l:Loc Audio_OutputHint}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{l:Loc Common_Refresh}" Command="{Binding RefreshDevicesCommand}" Margin="6,0,0,0" />
                            <ComboBox ItemsSource="{Binding Devices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding AudioDeviceId}" />
                        </DockPanel>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Loc Audio_Vad}" />
                        <CheckBox Content="{l:Loc Audio_UseVad}" IsChecked="{Binding AudioUseVad}" />
                        <TextBlock Style="{StaticResource Hint}" Text="{l:Loc Audio_UseVadHint}" />

                        <Expander Header="{l:Loc Common_Advanced}" Margin="0,10,0,0" HorizontalAlignment="Stretch">
                            <StackPanel Margin="0,6,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Loc Audio_SpeechThreshold, Value={Binding AudioSpeechThreshold}}" />
                                <Slider Minimum="0.2" Maximum="0.9" Value="{Binding AudioSpeechThreshold}" SmallChange="0.05" LargeChange="0.1" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Loc Audio_SilenceThreshold, Value={Binding AudioSilenceThreshold}}" />
                                <Slider Minimum="0.1" Maximum="0.8" Value="{Binding AudioSilenceThreshold}" SmallChange="0.05" LargeChange="0.1" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Loc Audio_EndSilence, Value={Binding AudioEndSilenceMs}}" />
                                <Slider Minimum="300" Maximum="1500" Value="{Binding AudioEndSilenceMs}" SmallChange="50" LargeChange="100" IsSnapToTickEnabled="True" TickFrequency="50" />
                                <!-- The trade-off is explained in a tooltip (label, info glyph and slider) to keep the tab short. -->
                                <StackPanel Background="Transparent" ToolTipService.ShowDuration="60000" ToolTipService.InitialShowDelay="300">
                                    <StackPanel.ToolTip>
                                        <ToolTip MaxWidth="460">
                                            <TextBlock Text="{l:Loc Audio_MaxUtteranceTip}" TextWrapping="Wrap" />
                                        </ToolTip>
                                    </StackPanel.ToolTip>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Loc Audio_MaxUtterance, Value={Binding AudioMaxUtteranceSec}}" />
                                        <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="6,10,0,3" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Slider Minimum="5" Maximum="25" Value="{Binding AudioMaxUtteranceSec}" IsSnapToTickEnabled="True" TickFrequency="1" />
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ───────────── Engine ───────────── -->
            <TabItem Header="{l:Loc Tab_Engine}" x:Name="EngineTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Loc Engine_Header}" />
                        <ComboBox ItemsSource="{Binding EngineModes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding EngineMode}" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Loc Engine_SpokenLanguage}" />
                        <ComboBox ItemsSource="{Binding LanguageChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding EngineLanguage}" />
                        <TextBlock Style="{StaticResource Hint}" Text="{l:Loc Engine_SpokenLanguageHint}" />

                        <StackPanel Visibility="{Binding IsLocalMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Loc Engine_Model}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{l:Loc Engine_ManageModels}" Click="ManageModels_OnClick" Margin="6,0,0,0" />
                                <ComboBox ItemsSource="{Binding ModelChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding EngineModelId}" />
                            </DockPanel>
                            <CheckBox Content="{l:Loc Engine_Partials}" IsChecked="{Binding EngineEnablePartials}" Margin="0,10,0,4" />
                            <Expander Header="{l:Loc Common_Advanced}" Margin="0,6,0,0" HorizontalAlignment="Stretch">
                                <StackPanel Margin="0,6,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Loc Engine_PartialInterval, Value={Binding EnginePartialIntervalMs}}" />
                                    <Slider Minimum="300" Maximum="2000" Value="{Binding EnginePartialIntervalMs}" IsSnapToTickEnabled="True" TickFrequency="100" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Loc Engine_PartialModel}" />
                                    <ComboBox ItemsSource="{Binding PartialModelChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding EnginePartialModelId}" />
                                    <TextBlock Style="{StaticResource Hint}" Text="{l:Loc Engine_PartialModelHint}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Loc Engine_Processor}" />
                                    <ComboBox ItemsSource="{Binding GpuChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding EngineGpu}" />
                                    <TextBlock Style="{StaticResource Hint}" Text="{l:Loc Engine_ProcessorHint}" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsApiMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" Text="{l:Loc Engine_ApiHint}" />
                            <Button Content="{l:Loc Engine_OpenApiSettings}" HorizontalAlignment="Left" Click="OpenApiTab_OnClick" Margin="0,6,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ───────────── Models ───────────── -->
            <TabItem Header="{l:Loc Tab_Models}" x:Name="ModelsTab" DataContext="{Binding Models}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="{Binding HardwareText}" Style="{StaticResource Hint}" Margin="0" />
                        <TextBlock Text="{Binding RecommendationText}" TextWrapping="Wrap" Margin="0,4,0,8" FontWeight="SemiBold" />
                        <Border Style="{StaticResource WarningBox}" Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}">
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                    <Border DockPanel.Dock="Bottom" Padding="0,8,0,0">
                        <WrapPanel Orientation="Horizontal">
                            <TextBlock Text="{l:Loc Models_CustomName}" VerticalAlignment="Center" />
                            <TextBox Text="{Binding CustomName, UpdateSourceTrigger=PropertyChanged}" Width="160" Margin="6,0" />
                            <TextBlock Text="{l:Loc Models_CustomLanguage}" VerticalAlignment="Center" />
                            <TextBox Text="{Binding CustomLanguage, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="6,0" />
                            <Button Content="{l:Loc Models_AddFile}" Command="{Binding AddCustomModelCommand}" />
                        </WrapPanel>
                    </Border>
                    <ListBox ItemsSource="{Binding Items}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource DefaultListBoxItemStyle}">
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Padding" Value="4,6" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ModelItemViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                            <Border Style="{StaticResource Badge}" Background="#FF2E7D32" Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{l:Loc Models_InUse}" Foreground="White" />
                                            </Border>
                                            <Border Style="{StaticResource Badge}" Background="#FF1565C0" Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{l:Loc Models_Recommended}" Foreground="White" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Details}" Style="{StaticResource Hint}" Margin="0" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Notes}" Style="{StaticResource Hint}" Margin="0" Visibility="{Binding Notes, Converter={StaticResource NullToCollapsed}}" />
                                        <ProgressBar Height="6" Margin="0,4,0,0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{Binding StateText}" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding BenchmarkText}" Margin="0,2,0,0" Visibility="{Binding BenchmarkText, Converter={StaticResource NullToCollapsed}}" />
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                        <Button Content="{Binding DownloadLabel}" Command="{Binding DownloadCommand}" Visibility="{Binding CanDownload, Converter={StaticResource BoolToVis}}" Margin="4,2" MinWidth="80" />
                                        <Button Content="{l:Loc Models_Pause}" Command="{Binding PauseCommand}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="4,2" MinWidth="80" />
                                        <Button Content="{l:Loc Common_Cancel}" Command="{Binding CancelCommand}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="4,2" MinWidth="80" />
                                        <Button Content="{l:Loc Models_Use}" Command="{Binding UseCommand}" Visibility="{Binding CanUse, Converter={StaticResource BoolToVis}}" Margin="4,2" MinWidth="80" />
                                        <Button Content="{l:Loc Models_Benchmark}" Command="{Binding BenchmarkCommand}" Visibility="{Binding CanUse, Converter={StaticResource BoolToVis}}" Margin="4,2" MinWidth="80" />
                                        <Button Content="{l:Loc Models_Delete}" Command="{Binding DeleteCommand}" Visibility="{Binding CanUse, Converter={StaticResource BoolToVis}}" Margin="4,2" MinWidth="80" />
                                    </WrapPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <!-- ───────────── API ───────────── -->
            <TabItem Header="{l:Loc Tab_Api}" x:Name="ApiTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Loc Api_Header}" />
                        <TextBlock Style="{StaticResource Hint}" Text="{l:Loc Api_Hint}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Loc Api_Provider}" />
                        <ComboBox ItemsSource="{Binding ApiProviders}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ApiProvider}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Loc Api_Key}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{l:Loc Api_SaveKey}" Click="SaveKey_OnClick" Margin="6,0,0,0" />
                            <PasswordBox x:Name="ApiKeyBox" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="{l:Loc Api_KeyHint}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Loc Api_Model}" />
                        <DockPanel Visibility="{Binding IsPresetProvider, Converter={StaticResource BoolToVis}}">
                            <Button DockPanel.Dock="Right" Content="{l:Loc Common_Refresh}" Command="{Binding RefreshApiModelsCommand}" Margin="6,0,0,0" />
                            <ComboBox ItemsSource="{Binding ApiModelChoices}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedApiModel}" />
                        </DockPanel>
                        <TextBox Text="{Binding ApiModel, UpdateSourceTrigger=LostFocus}" Visibility="{Binding IsCustomProvider, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding ModelListStatus}" Visibility="{Binding ModelListStatus, Converter={StaticResource NullToCollapsed}}" />
                        <TextBlock Style="{StaticResource Hint}" Text="{l:Loc Api_ModelsHint}" Visibility="{Binding IsPresetProvider, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Loc Api_BaseUrl}" />
                        <TextBox Text="{Binding ApiBaseUrl, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Style="{StaticResource Hint}" Text="{l:Loc Api_SelfHostedHint}" Visibility="{Binding IsSelfHostedProvider, Converter={StaticResource BoolToVis}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="{l:Loc Api_TestConnection}" Command="{Binding TestConnectionCommand}" />
                            <TextBlock Text="{Binding ApiTestResult}" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox Content="{l:Loc Api_Partials}" IsChecked="{Binding ApiEnablePartials}" Margin="0,12,0,0"
                                  Visibility="{Binding IsUploadModel, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0" Text="{l:Loc Api_StreamingHint}"
                                   Visibility="{Binding IsHostedStreamingModel, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0" Text="{l:Loc Api_StreamingServerHint}"
                                   Visibility="{Binding IsSelfHostedStreaming, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ───────────── Overlay ───────────── -->
            <TabItem Header="{l:Loc Tab_Overlay}" x:Name="OverlayTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{l:Loc Overlay_MoveResize}" Command="{Binding EditOverlayPositionCommand}" />
                            <Button Content="{l:Loc Overlay_ResetStyle}" Command="{Binding ResetOverlayStyleCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Loc Overlay_Text}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Loc Overlay_Font}" />
                        <ComboBox ItemsSource="{Binding FontFamilies}" SelectedItem="{Binding OverlayFontFamily}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Loc Overlay_Size, Value={Binding OverlayFontSize}}" />
                        <Slider Minimum="12" Maximum="80" Value="{Binding OverlayFontSize}" IsSnapToTickEnabled="True" TickFrequency="1" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Loc Overlay_Weight, Value={Binding OverlayFontWeight}}" />
                        <Slider Minimum="300" Maximum="900" Value="{Binding OverlayFontWeight}" IsSnapToTickEnabled="True" TickFrequency="100" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Loc Overlay_TextColor}" />
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Width="24" Margin="6,0,0,0" BorderBrush="Gray" BorderThickness="1" Background="{Binding OverlayTextColor, Converter={StaticResource ColorToBrush}}" />
                                    <TextBox Text="{Binding OverlayTextColor, UpdateSourceTrigger=LostFocus}" />
                                </DockPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Loc Overlay_OutlineColor}" />
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Width="24" Margin="6,0,0,0" BorderBrush="Gray" BorderThickness="1" Background="{Binding OverlayOutlineColor, Converter={StaticResource ColorToBrush}}" />
                                    <TextBox Text="{Binding OverlayOutlineColor, UpdateSourceTrigger=LostFocus}" />
                                </DockPanel>
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Loc Overlay_OutlineThickness, Value={Binding OverlayOutlineThickness}}" />
                        <Slider Minimum="0" Maximum="6" Value="{Binding OverlayOutlineThickness}" IsSnapToTickEnabled="True" TickFrequency="0.5" />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Loc Overlay_Background}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Loc Overlay_BackgroundColor}" />
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Width="24" Margin="6,0,0,0" BorderBrush="Gray" BorderThickness="1" Background="{Binding OverlayBackgroundColor, Converter={StaticResource ColorToBrush}}" />
                            <TextBox Text="{Binding OverlayBackgroundColor, UpdateSourceTrigger=LostFocus}" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Loc Overlay_Opacity, Value={Binding OverlayBackgroundOpacity}}" />
                        <Slider Minimum="0" Maximum="1" Value="{Binding OverlayBackgroundOpacity}" SmallChange="0.05" LargeChange="0.1" />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Loc Overlay_Behaviour}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Loc Overlay_LinesShown, Value={Binding OverlayLinesShown}}" />
                        <Slider Minimum="1" Maximum="6" Value="{Binding OverlayLinesShown}" IsSnapToTickEnabled="True" TickFrequency="1" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Loc Overlay_FadeTimeout, Value={Binding OverlayFadeTimeoutSec}}" />
                        <Slider Minimum="0" Maximum="60" Value="{Binding OverlayFadeTimeoutSec}" IsSnapToTickEnabled="True" TickFrequency="1" />
                        <CheckBox Content="{l:Loc Overlay_AnimateLines}" IsChecked="{Binding OverlayAnimateLines}" Margin="0,8,0,0" />
                        <CheckBox Content="{l:Loc Overlay_ShowSoundTags}" IsChecked="{Binding OverlayShowSoundTags}" Margin="0,8,0,0" />
                        <TextBlock Style="{StaticResource Hint}" Text="{l:Loc Overlay_ShowSoundTagsHint}" />
                        <TextBlock Style="{StaticResource Hint}" Text="{l:Loc Overlay_FullscreenHint}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ───────────── Hotkeys ───────────── -->
            <TabItem Header="{l:Loc Tab_Hotkeys}" x:Name="HotkeysTab">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Loc Hotkeys_Header}" />
                    <TextBlock Style="{StaticResource Hint}" Text="{l:Loc Hotkeys_Hint}" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Loc Hotkeys_EditMode}" />
                    <TextBox Text="{Binding HotkeysToggleEditMode}" PreviewKeyDown="Hotkey_OnPreviewKeyDown" IsReadOnlyCaretVisible="False" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Loc Hotkeys_Pause}" />
                    <TextBox Text="{Binding HotkeysPauseResume}" PreviewKeyDown="Hotkey_OnPreviewKeyDown" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Loc Hotkeys_Clear}" />
                    <TextBox Text="{Binding HotkeysClearOverlay}" PreviewKeyDown="Hotkey_OnPreviewKeyDown" />
                    <Border Style="{StaticResource WarningBox}" Visibility="{Binding HotkeyErrors, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock Text="{Binding HotkeyErrors}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- ───────────── About ───────────── -->
            <TabItem Header="{l:Loc Tab_About}" x:Name="AboutTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="{Binding VersionText}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding RuntimeText}" Style="{StaticResource Hint}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="{l:Loc About_CheckUpdates}" Command="{Binding CheckUpdatesCommand}" />
                            <Button Content="{l:Loc About_Releases}" Command="{Binding OpenReleasePageCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding UpdateText}" Margin="0,4,0,0" FontWeight="SemiBold" Visibility="{Binding UpdateText, Converter={StaticResource NullToCollapsed}}" />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Loc About_Privacy}" />
                        <TextBlock TextWrapping="Wrap" Text="{l:Loc About_PrivacyText}" />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Loc Common_Diagnostics}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{l:Loc About_OpenLogs}" Command="{Binding OpenLogsFolderCommand}" />
                            <Button Content="{l:Loc About_ExportDiagnostics}" Command="{Binding ExportDiagnosticsCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding DiagnosticsResult}" TextWrapping="Wrap" Margin="0,6,0,0" />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Loc About_Credits}" />
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource Hint}" Text="{l:Loc About_CreditsText}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
